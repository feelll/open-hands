/* pages/game/game.wxss */
.game-container {
  width: 100vw;
  height: 100vh;
  background: linear-gradient(to bottom, #000428, #004e92);
  position: relative;
  overflow: hidden;
}

.game-canvas {
  width: 100vw;
  height: 70vh;
  background: transparent;
}

.game-ui {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  right: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.score-info {
  display: flex;
  flex-direction: column;
}

.ui-text {
  color: #00ffff;
  font-size: 32rpx;
  text-shadow: 0 0 10rpx #00ffff;
  margin-bottom: 10rpx;
}

.high-score {
  text-align: right;
}

.game-over {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
}

.game-over-content {
  background: linear-gradient(45deg, #000428, #004e92);
  padding: 60rpx;
  border-radius: 20rpx;
  text-align: center;
  border: 4rpx solid #00ffff;
  box-shadow: 0 0 40rpx #00ffff;
}

.game-over-title {
  color: #ff0000;
  font-size: 48rpx;
  font-weight: bold;
  text-shadow: 0 0 20rpx #ff0000;
  display: block;
  margin-bottom: 30rpx;
}

.final-score {
  color: #00ffff;
  font-size: 36rpx;
  text-shadow: 0 0 15rpx #00ffff;
  display: block;
  margin-bottom: 40rpx;
}

.restart-btn, .share-btn {
  background: linear-gradient(45deg, #00ffff, #0080ff);
  color: white;
  border: none;
  padding: 20rpx 40rpx;
  margin: 10rpx;
  border-radius: 10rpx;
  font-size: 32rpx;
  box-shadow: 0 0 20rpx rgba(0, 255, 255, 0.3);
}

.restart-btn:active, .share-btn:active {
  transform: scale(0.95);
}

.controls {
  position: absolute;
  bottom: 50rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.control-row {
  display: flex;
  align-items: center;
  margin: 10rpx 0;
}

.control-btn {
  width: 100rpx;
  height: 100rpx;
  background: rgba(0, 255, 255, 0.2);
  border: 2rpx solid #00ffff;
  border-radius: 50%;
  color: #00ffff;
  font-size: 40rpx;
  font-weight: bold;
  margin: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 20rpx rgba(0, 255, 255, 0.3);
}

.control-btn:active {
  background: rgba(0, 255, 255, 0.4);
  transform: scale(0.9);
}

.shoot-btn {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(45deg, #ff6600, #ff0000);
  border: 2rpx solid #ff0000;
  border-radius: 50%;
  color: white;
  font-size: 28rpx;
  font-weight: bold;
  margin: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 30rpx rgba(255, 0, 0, 0.5);
}

.shoot-btn:active {
  transform: scale(0.9);
  box-shadow: 0 0 40rpx rgba(255, 0, 0, 0.8);
}

.pause-btn {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 2rpx solid #ffffff;
  border-radius: 10rpx;
  padding: 15rpx 30rpx;
  color: #ffffff;
  font-size: 28rpx;
}